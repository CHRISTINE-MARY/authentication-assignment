# Supabase session pooler (IPv4). Direct db.* hosts are often IPv6-only.
# User is postgres.YOUR_PROJECT_REF
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Long random string used to hash one-time codes and session tokens.
OTP_PEPPER=replace-with-a-long-random-string

# Browser origin allowed to call this API.
FRONTEND_ORIGIN=http://localhost:3000

# Sender address used by either Resend or SMTP.
EMAIL_FROM=

# Option 1: Resend (https://resend.com)
RESEND_API_KEY=

# Option 2: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
